generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  color     String   @default("#6366f1")
  role      String   @default("member") // "admin" | "member"
  createdAt DateTime @default(now())

  sessions   WorkSession[]
  goals      Goal[]
  activities Activity[]
  notes      Note[]
}

model WorkSession {
  id              Int       @id @default(autoincrement())
  userId          Int
  date            DateTime  @db.Date
  checkinAt       DateTime
  checkoutAt      DateTime?
  durationMinutes Int?

  user User @relation(fields: [userId], references: [id])
}

model Goal {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  title     String
  vertical  String   // studio | originals | auto | agency | geral
  priority  String   @default("medium") // low | medium | high
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Activity {
  id          Int      @id @default(autoincrement())
  userId      Int
  date        DateTime @db.Date
  title       String
  vertical    String
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Note {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

// Demandas compartilhadas — visíveis para todo o time
model Demand {
  id          String   @id @default(cuid())
  text        String
  priority    String   @default("média")
  dueDate     String?
  done        Boolean  @default(false)
  sourceName  String
  sourceColor String
  sourceType  String
  createdAt   DateTime @default(now())
}

// Pendências críticas dos projetos — compartilhado com todo o time
model Pendencia {
  id        String   @id @default(cuid())
  text      String
  project   String   // ex: CasaPrime, Facilis, SureThing, STUDIO, etc.
  priority  String   @default("alta") // alta | media
  done      Boolean  @default(false)
  doneBy    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Runbook "Como Trabalhamos" — onboarding/metodologia por vertical.
// Leitura: todos os membros. Edição: apenas admin (gating no route).
model RunbookPage {
  id        Int      @id @default(autoincrement())
  vertical  String   // "auto" | "studio"
  categoria String   @default("processo") // "lei_geral" | "processo"
  slug      String   @unique
  titulo    String
  conteudo  String   @db.Text @default("")
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vertical, ordem])
}

// Hub de Projetos — visão de empresa de todas as ventures.
// Leitura: todos. Escrita: só admin.
model Project {
  id          Int      @id @default(autoincrement())
  nome        String
  vertical    String   // "auto" | "studio"
  status      String   @default("ativo") // ativo | pausado | planejado | arquivado
  descricao   String?  @db.Text
  responsavel String?
  repoUrl     String?
  deployUrl   String?
  docsUrl     String?
  cor         String   @default("#6366f1")
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vertical, ordem])
}

// Métricas / KPIs — snapshot mensal. Acesso e edição EXCLUSIVOS do admin.
model KpiSnapshot {
  id              Int      @id @default(autoincrement())
  mes             String   @unique  // "YYYY-MM"
  caixa           Float    @default(0)
  gastos          Float    @default(0)
  kelsenCadastros Int      @default(0)
  kelsenTestando  Int      @default(0)
  kelsenPagantes  Int      @default(0)
  projetos        String   @db.Text @default("[]") // JSON: [{nome, mrr, receita}]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
